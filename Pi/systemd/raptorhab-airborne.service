[Unit]
Description=RaptorHab Airborne Payload
Documentation=https://github.com/raptorhab/raptorhab
After=network.target
Wants=network.target

# Never stop trying to restart the payload. systemd's default rate limiting
# (5 starts in 10s) would put the unit permanently in a failed state after a
# short burst of crashes -- which on a balloon means the flight is over.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/raptorhab
ExecStart=/usr/bin/python3 -m airborne.main
Restart=always
# Every second here is dead air on the downlink.
RestartSec=3
TimeoutStopSec=30

# Resource limits
MemoryMax=256M
CPUQuota=80%

# Security hardening
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/raptorhab

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raptorhab-airborne

[Install]
WantedBy=multi-user.target
